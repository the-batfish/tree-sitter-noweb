{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "noweb",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "documentation"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "code_chunk"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "documentation"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "code_chunk": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "chunk_header"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "chunk_content"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "chunk_terminator"
        }
      ]
    },
    "chunk_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<<"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "chunk_name"
          }
        },
        {
          "type": "STRING",
          "value": ">>="
        }
      ]
    },
    "chunk_name": {
      "type": "PATTERN",
      "value": "[^>]+"
    },
    "chunk_content": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "chunk_reference"
          },
          {
            "type": "SYMBOL",
            "name": "_content_line"
          }
        ]
      }
    },
    "chunk_reference": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "<<"
          },
          {
            "type": "FIELD",
            "name": "name",
            "content": {
              "type": "SYMBOL",
              "name": "chunk_name"
            }
          },
          {
            "type": "STRING",
            "value": ">>"
          }
        ]
      }
    },
    "_content_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^\\n<@]+"
        },
        {
          "type": "STRING",
          "value": "<"
        }
      ]
    },
    "chunk_terminator": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "@"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "chunk_annotation"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "chunk_annotation": {
      "type": "PATTERN",
      "value": "[^\\n]*"
    },
    "documentation": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "doc_marker"
            },
            {
              "type": "PATTERN",
              "value": "[^<@\\n]+"
            },
            {
              "type": "STRING",
              "value": "<"
            }
          ]
        }
      }
    },
    "doc_marker": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[^\\n]*"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}